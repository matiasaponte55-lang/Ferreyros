**/dist/
.npm
*.log

# --- Variables de Entorno y Secretos ---
.env
.env.*
!.env.example

# --- Archivos de IDE y Sistema Operativo ---
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

.metals/
*.metals
