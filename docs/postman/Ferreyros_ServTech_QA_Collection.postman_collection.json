  "item": [
    {
      "name": "01. Autenticación & Perímetro RBAC",
      "item": [
        {
          "name": "01.1 - Login Exitoso con Credenciales Reales (Genera JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respuesta contiene token JWT válido', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.token.length).to.be.above(20);",
                  "    pm.environment.set('token', jsonData.token);",
                  "});",
                  "pm.test('Rol de usuario verificado en BD Supabase', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('rol');",
                  "});",
                  "pm.test('Tiempo de respuesta inferior a 1200ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Valida autenticación contra base de datos Supabase y emisión de token JWT con rol RBAC verificado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{supervisor_user}}\",\n  \"password\": \"{{supervisor_pass}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "01.2 - [Error 401] Rechazo de Credenciales Inválidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
